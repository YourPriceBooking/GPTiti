{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "lib/chat/chatProtocol.ts",
    "lib/chat/chatDelivery.ts",
    "lib/chat/chatState.ts",
    "types/api.types.ts",
    "types/types.ts",
    "tests/**/*.test.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
